# =============================================================================
# DataForge (sql-practice-platform) — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# Practice database (Northwind tables — used for SQL execution)
DATABASE_URL=postgresql+asyncpg://sql_readonly:readonly_pass@localhost:5432/northwind

# Application database (questions, attempts, progress — separate from practice data)
APP_DATABASE_URL=postgresql+asyncpg://sql_app:app_pass@localhost:5432/sql_practice

# Admin / migration connection (full privileges for setup scripts)
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/northwind
APP_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sql_practice

# GitHub integration (optional — leave empty to use local questions/questions.json)
GITHUB_REPOSITORY=Subramanya12244/northwind-sql-practice
GITHUB_TOKEN=
GITHUB_BRANCH=main
GITHUB_QUESTIONS_PATH=questions/questions.json

# Local clone of your Northwind SQL GitHub repo (preferred sync source)
NORTHWIND_REPO_PATH=
# Example: /Users/you/project/northwind-sql-practice

# Query execution
QUERY_TIMEOUT_SECONDS=5
QUERY_MAX_ROWS=1000

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local default user (auth can be added later)
DEFAULT_USER_ID=1
DEFAULT_USER_NAME=local_user

# =============================================================================
# Multi-project datasets
# Uploading a dataset provisions a dedicated PostgreSQL database per project,
# so POSTGRES_ADMIN_URL needs CREATEDB privileges.
# =============================================================================
POSTGRES_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
PROJECT_DB_HOST=localhost
PROJECT_DB_PORT=5432
PROJECT_DB_OWNER=postgres
PROJECT_DB_OWNER_PASSWORD=postgres
# Granted SELECT on every project database so the editor can query it read-only
PROJECT_DB_READONLY_USER=sql_readonly
PROJECT_DB_READONLY_PASSWORD=readonly_pass
PROJECT_DB_PREFIX=sqlp_
PROJECTS_ROOT=../projects
MAX_UPLOAD_MB=200
