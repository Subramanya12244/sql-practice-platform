    "marked": "18.1.1",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sql-formatter": "^15.4.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
